# ── Copy to .env and fill in. Never commit .env (it is gitignored). ──────────────

# ── Core ─────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:6543/postgres
DIRECT_URL=postgresql://user:pass@host:5432/postgres
PORT=3000
ALLOW_ORIGIN=http://localhost:5173

OPENAI_API_KEY=

# Must match the platform API's secret — copilot-server verifies the tokens it mints.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Models (all optional; defaults in code) ──────────────────────────────────────
# ESTIMATE_MODEL is the estimate/vision model. NOTE: OPENAI_AGENT_MODEL is a shared
# fallback for BOTH the general copilot node and the estimate node, so set
# ESTIMATE_MODEL explicitly if you want to tune one without moving the other.
ESTIMATE_MODEL=gpt-5.4
OPENAI_AGENT_MODEL=gpt-5.4-mini
ORCHESTRATOR_ROUTER_MODEL=gpt-5.4-nano
OPENAI_IMAGE_SUMMARY_MODEL=gpt-4o-mini
VECTOR_STORE_ID=

# ── AWS / S3 ─────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
S3_BUCKET=

# ── Email (estimate PDFs) ────────────────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=

# ── Home Depot catalog (Estimating Agent) ────────────────────────────────────────
# Prices a pricebook MISS from Home Depot and writes the item into the company's
# pricebook, so matchPricebook() finds it on later turns with no API call.
#
# Entirely inert until at least one key is set — with none, pricing behaves exactly
# as it did before the catalog existed.
#
# Numbered pool: add or remove keys without touching code. Rotation is round-robin
# and a key that reports quota/429 is cooled down while the next one is tried.
# The resolver issues 5 searches per unmatched item, and SerpApi bills per search
# and throttles concurrency, so more keys = more headroom.
SERP_API_KEY_1=
# SERP_API_KEY_2=
# SERP_API_KEY_3=

# Home Depot prices are store-specific. Optional — defaults to a working ZIP in
# code; set this per deployment once regional pricing matters.
# SERP_DELIVERY_ZIP=

# How long a key sits out after reporting quota exhaustion. Default 15 min.
# SERP_KEY_COOLDOWN_MS=900000

# Per-request timeout. A cold search runs ~13s; transient 5xx/timeouts retry twice on the
# SAME key (an outage is not a key problem). Default 25s.
# SERP_REQUEST_TIMEOUT_MS=25000
