generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public"]
}

model audio_files {
  id                       BigInt                 @id @default(autoincrement())
  visit_session_id         BigInt
  type                     String                 @db.VarChar(50)
  s3_uri                   String
  start_timestamp_ms       BigInt
  end_timestamp_ms         BigInt
  format                   String                 @db.VarChar(50)
  meta_data                Json?                  @default("{}")
  created_at               DateTime               @default(now()) @db.Timestamp(6)
  updated_at               DateTime               @default(now()) @db.Timestamp(6)
  transcription_session_id BigInt
  transcription_sessions   transcription_sessions @relation(fields: [transcription_session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  visit_sessions           visit_sessions         @relation(fields: [visit_session_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_audio_files_visit_session")

  @@index([visit_session_id], map: "idx_audio_files_visit_session_id")
  @@schema("public")
}

model companies {
  id               Int                @id @default(autoincrement())
  name             String             @db.VarChar
  logo_url         String?
  city             String?            @db.VarChar
  state            String?            @db.VarChar
  country          String?            @db.VarChar
  postal_code      String?            @db.VarChar
  geocoded_lat     Float?
  geocoded_lng     Float?
  created_at       DateTime           @default(now()) @db.Timestamp(6)
  updated_at       DateTime           @default(now()) @db.Timestamp(6)
  address          Json?              @default("{}")
  /// Service-location address from registration ({line1, city, state, postal_code, country}).
  /// `address` is the billing/mailing address; documents fall back to these when a job has none.
  service_address  Json?
  phone            String?            @db.VarChar(20)
  email            String?            @db.VarChar(200)
  license_number   String?            @db.VarChar(100)
  /// Per-company proposal email body with {{placeholders}}; null = built-in default.
  proposal_email_template String?
  /// Per-company proposal DOCUMENT format: an ordered ProposalBlock[] (see
  /// copilot/estimating/proposalTemplate.ts) driving both the emailed PDF and the .docx
  /// download. Null = the built-in hardcoded proposal, unchanged.
  proposal_template       Json?
  website          String?            @db.VarChar(300)
  footer_terms     String?
  company_configs  company_configs?
  crm_connections  crm_connections?
  crm_entity_links crm_entity_links[]
  jobs             jobs[]
  users            users[]

  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model company_configs {
  id                     Int       @id @default(autoincrement())
  company_id             Int       @unique
  checklists             Json
  updated_at             DateTime  @default(now()) @db.Timestamp(6)
  sales_coaching_enabled Boolean   @default(true)
  /// Home Depot fallback pricing for pricebook misses (pricebook-config PRD US5).
  /// Default ON (PM decision 2026-08-21): the automatic fallback is pre-existing behavior
  /// for every client, so this switch exists to opt a client OUT, not in. Turned off, that
  /// client's quotes price only from their own book(s).
  hd_fallback_enabled    Boolean   @default(true)
  /// Company default markup %, applied as the starting markupPercent of NEW quotes only
  /// (QBO PRD US7 — knowingly reverses the earlier per-quote-only markup decision).
  /// Per-quote markup stays editable; existing quotes are never touched by a change here.
  default_markup_percent Decimal   @default(0) @db.Decimal(5, 2)
  companies              companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model jobs {
  id                    BigInt                 @id @default(autoincrement())
  company_id            Int
  technician_id         BigInt?
  start_timestamp       DateTime               @db.Timestamp(6)
  address               String                 @db.VarChar
  geocoded_lat          Float?
  geocoded_lng          Float?
  description           String?
  job_target_name       String                 @db.VarChar
  created_at            DateTime               @default(now()) @db.Timestamp(6)
  updated_at            DateTime               @default(now()) @db.Timestamp(6)
  status                job_status             @default(scheduled)
  meta_data             Json?
  conversations         Conversation[]
  companies             companies              @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                 users?                 @relation(fields: [technician_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  visit_session_metrics visit_session_metrics?
  visit_sessions        visit_sessions?

  @@schema("public")
}

model sessions {
  id                 Int      @id @default(autoincrement())
  user_id            BigInt
  refresh_token_hash String   @db.VarChar(255)
  user_agent         String?
  ip_address         String?  @db.Inet
  expires_at         DateTime @db.Timestamp(6)
  created_at         DateTime @default(now()) @db.Timestamp(6)
  updated_at         DateTime @default(now()) @db.Timestamp(6)
  users              users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model transcription_sessions {
  id                  BigInt                @id @default(autoincrement())
  visit_session_id    BigInt
  starts_at           DateTime?             @db.Timestamp(6)
  ends_at             DateTime?             @db.Timestamp(6)
  meta_data           Json?                 @default("{}")
  created_at          DateTime              @default(now()) @db.Timestamp(6)
  updated_at          DateTime              @default(now()) @db.Timestamp(6)
  last_heartbeat_at   DateTime?             @db.Timestamp(6)
  audio_files         audio_files[]
  visit_sessions      visit_sessions        @relation(fields: [visit_session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  transcription_turns transcription_turns[]

  @@index([visit_session_id], map: "idx_transcription_sessions_visit_session_id")
  @@schema("public")
}

model transcription_turns {
  id                       BigInt                 @id @default(autoincrement())
  visit_session_id         BigInt
  transcription_session_id BigInt
  turn_index               Int
  start_timestamp_ms       BigInt
  end_timestamp_ms         BigInt
  speaker                  String?                @db.VarChar(50)
  text                     String
  audio_s3_uri             String?
  meta_data                Json?                  @default("{}")
  created_at               DateTime               @default(now()) @db.Timestamp(6)
  updated_at               DateTime               @default(now()) @db.Timestamp(6)
  provider                 transcription_provider
  provider_result_id       String                 @db.VarChar(200)
  transcription_sessions   transcription_sessions @relation(fields: [transcription_session_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_transcription_turns_transcription_session")
  visit_sessions           visit_sessions         @relation(fields: [visit_session_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_transcription_turns_visit_session")

  @@index([transcription_session_id], map: "idx_transcription_turns_transcription_session_id")
  @@index([visit_session_id], map: "idx_transcription_turns_visit_session_id")
  @@schema("public")
}

model users {
  id                    BigInt                  @id @default(autoincrement())
  first_name            String                  @db.VarChar(100)
  last_name             String                  @db.VarChar(100)
  job_title             String?                 @db.VarChar(150)
  email                 String                  @unique(map: "idx_users_email") @db.VarChar(200)
  role                  user_role               @default(technician)
  hashed_password       String                  @db.VarChar(255)
  created_at            DateTime                @default(now()) @db.Timestamp(6)
  updated_at            DateTime                @default(now()) @db.Timestamp(6)
  company_id            Int
  address               Json?                   @default("{}")
  phone_number          String?                 @db.VarChar(20)
  username              String                  @db.VarChar(200)
  conversations         Conversation[]
  jobs                  jobs[]
  messages              Message[]
  sessions              sessions[]
  companies             companies               @relation(fields: [company_id], references: [id], onUpdate: NoAction, map: "fk_users_company")
  visit_session_metrics visit_session_metrics[]
  visit_sessions        visit_sessions[]

  @@unique([company_id, username], map: "uq_users_company_username")
  @@schema("public")
}

model visit_sessions {
  id                     BigInt                   @id @default(autoincrement())
  job_id                 BigInt                   @unique(map: "idx_visit_sessions_job_id")
  technician_id          BigInt
  start_time             DateTime                 @db.Timestamp(6)
  end_time               DateTime?                @db.Timestamp(6)
  status                 session_status           @default(active)
  meta_data              Json?                    @default("{}")
  created_at             DateTime                 @default(now()) @db.Timestamp(6)
  updated_at             DateTime                 @default(now()) @db.Timestamp(6)
  checklists             Json                     @default("{}")
  job_summary            String?
  audio_files            audio_files[]
  transcription_sessions transcription_sessions[]
  transcription_turns    transcription_turns[]
  jobs                   jobs                     @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_visit_sessions_job")
  users                  users                    @relation(fields: [technician_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_visit_sessions_technician")

  @@schema("public")
}

model Conversation {
  id             String             @id @default(uuid())
  userId         BigInt?            @map("user_id")
  jobId          BigInt?            @map("job_id")
  channelType    ChannelType        @map("channel_type")
  members        String[]
  status         ConversationStatus @default(ACTIVE)
  metadata       Json?              @default("{}")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  conversationId String?            @map("openai_conversation_id")
  jobs           jobs?              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  users          users?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageFiles     ImageFile[]
  messages       Message[]
  quote          Quote?

  @@index([userId])
  @@index([conversationId])
  @@index([status])
  @@index([createdAt])
  @@index([jobId], map: "conversations_job_id_key")
  @@map("conversations")
  @@schema("public")
}

model Message {
  id             String        @id @default(uuid())
  conversationId String        @map("conversation_id")
  senderType     SenderType    @map("sender_type")
  senderId       BigInt?       @map("sender_id")
  content        String
  contentType    ContentType   @default(TEXT) @map("content_type")
  attachments    Json?         @default("[]")
  metadata       Json?         @default("{}")
  status         MessageStatus @default(SENT)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  imageFiles     ImageFile[]
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  users          users?        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  toolCalls      ToolCall[]

  @@index([conversationId])
  @@index([senderType])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
  @@schema("public")
}

model ImageFile {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  /// Null for an image attached directly to the QUOTE (estimator attach action, PRD US6)
  /// rather than sent with a chat message. Message-attached images reach the agent as vision
  /// input; quote-attached images never do — no analysis of any kind, attach-and-display only.
  messageId      String?      @map("message_id")
  s3Key          String       @map("s3_key")
  mimeType       String       @map("mime_type")
  sizeBytes      BigInt?      @map("size_bytes")
  filename       String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        Message?     @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([messageId])
  @@map("image_files")
  @@schema("public")
}

model ToolCall {
  id          String         @id @default(uuid())
  messageId   String         @map("message_id")
  toolName    String         @map("tool_name")
  toolInput   Json           @map("tool_input")
  toolOutput  Json?          @map("tool_output")
  status      ToolCallStatus @default(PENDING)
  startedAt   DateTime       @default(now()) @map("started_at")
  completedAt DateTime?      @map("completed_at")
  durationMs  Int?           @map("duration_ms")
  error       String?
  message     Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([toolName])
  @@index([status])
  @@map("tool_calls")
  @@schema("public")
}

model visit_session_metrics {
  id                        BigInt   @id @default(autoincrement())
  job_id                    BigInt   @unique
  technician_id             BigInt
  technician_talk_time_sec  Int
  customer_talk_time_sec    Int
  technician_talk_ratio_pct Decimal  @db.Decimal(5, 2)
  total_exchanges           Int
  talk_speed_wpm            Int
  checklist_score_pct       Decimal  @db.Decimal(5, 2)
  star_rating               Decimal  @db.Decimal(2, 1)
  calculated_at             DateTime @default(now()) @db.Timestamp(6)
  meta_data                 Json     @default("{}")
  jobs                      jobs     @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_vsm_job")
  users                     users    @relation(fields: [technician_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_vsm_technician")

  @@schema("public")
}

model crm_connections {
  id               Int                @id @default(autoincrement())
  company_id       Int                @unique(map: "uq_crm_connections_company")
  provider         crm_provider
  auth_type        crm_auth_type
  encrypted_auth   Json
  provider_config  Json?
  expires_at       DateTime?          @db.Timestamptz(6)
  last_verified_at DateTime?          @db.Timestamptz(6)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  companies        companies          @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_crm_connections_company")
  crm_entity_links crm_entity_links[]

  @@schema("public")
}

model crm_entity_links {
  id                        BigInt          @id @default(autoincrement())
  company_id                Int
  crm_connection_id         Int
  entity_type               crm_entity_type
  canonical_id              BigInt
  provider_entity_id        String          @db.VarChar(128)
  provider_payload          Json?
  last_synced_at            DateTime?       @db.Timestamptz(6)
  remote_modified_at        DateTime?       @db.Timestamptz(6)
  created_at                DateTime        @default(now()) @db.Timestamptz(6)
  updated_at                DateTime        @default(now()) @db.Timestamptz(6)
  parent_provider_entity_id String?         @db.VarChar(128)
  provider_assignment_id    String?         @db.VarChar(128)
  companies                 companies       @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_crm_entity_links_company")
  crm_connections           crm_connections @relation(fields: [crm_connection_id], references: [id], onUpdate: NoAction, map: "fk_crm_entity_links_connection")

  @@unique([crm_connection_id, entity_type, canonical_id], map: "uq_canonical_entity")
  @@index([crm_connection_id, entity_type, remote_modified_at(sort: Desc)], map: "idx_crm_entity_links_connection_entity_remote_modified")
  @@schema("public")
}

/// QuickBooks Online connection, one per company. Deliberately NOT a crm_connections row:
/// that table is owned by the platform backend, is capped at one connection per company,
/// and extending its provider enum would break the other service's generated client on read.
/// No FK/relation, matching Pricebook/LaborRate (runbook-managed DDL).
///
/// Two-phase row (QBO PRD US1): created when the admin saves the company's QuickBooks app
/// keys in settings; the token fields stay null until the OAuth consent completes. Connected
/// means encrypted_auth is non-null.
model QboConnection {
  id                   Int       @id @default(autoincrement())
  companyId            Int       @unique @map("company_id")
  /// The company's own Intuit app key (QBO PRD US1). Public identifier, not a secret.
  clientId             String    @map("client_id")
  /// AES-256-GCM sealed Client Secret — sealed/opened in lib/qbo.ts.
  encryptedClientSecret String   @map("encrypted_client_secret")
  /// "production" | "sandbox" — selects the QBO API base per connection.
  environment          String    @default("production")
  /// The QBO company id Intuit hands back on the OAuth callback. Null until consented.
  realmId              String?   @map("realm_id")
  /// AES-256-GCM blob of { accessToken, refreshToken }. Null until consented.
  encryptedAuth        String?   @map("encrypted_auth")
  accessTokenExpiresAt DateTime? @map("access_token_expires_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("qbo_connections")
  @@schema("public")
}

/// Estimating Agent: one chat = one quote, lifecycle DRAFT -> COMPLETED.
model Quote {
  id             String          @id @default(uuid())
  conversationId String          @unique @map("conversation_id")
  userId         BigInt          @map("user_id")
  companyId      Int             @map("company_id")
  status         QuoteStatus     @default(DRAFT)
  /// Per-quote materials markup, as a percentage. Applies to MATERIAL lines only — labor is
  /// never marked up (isLabor). 0 = no markup. Editable while DRAFT, frozen on COMPLETED.
  /// Deliberately per-quote: there is no client-level default markup anywhere in the product.
  markupPercent  Decimal         @default(0) @map("markup_percent") @db.Decimal(5, 2)
  /// Customer identification, per quote. Free text with NO format validation (PRD is
  /// explicit), all optional — a quote completes with zero, one, two, or all three set.
  /// Per-quote data like line items: never persisted, deduped, or autofilled across quotes.
  customerName    String?        @map("customer_name")
  customerAddress String?        @map("customer_address")
  customerPhone   String?        @map("customer_phone")
  /// Template in effect when this quote was CREATED (template-config PRD): a later template
  /// reassignment never touches an existing quote. Null = the built-in default invoice.
  templateId     Int?            @map("template_id")
  /// The end-of-materials labor-hours ask fires at most once per quote (labor PRD US2).
  laborAsked     Boolean         @default(false) @map("labor_asked")
  /// QBO Estimate id once posted (companies with a QboConnection). Posted at completion;
  /// re-completing after a reopen UPDATES this same estimate in place (QBO PRD US6).
  qboEstimateId  String?         @map("qbo_estimate_id")
  /// Which option group the customer chose, answered at completion time (QBO PRD US3).
  /// Null = not asked / no options. Cleared on reopen so re-completion asks again.
  chosenOptionGroup String?      @map("chosen_option_group")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  completedAt    DateTime?       @map("completed_at")
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  lineItems      QuoteLineItem[]

  @@index([userId, status])
  @@map("quotes")
  @@schema("public")
}

model QuoteLineItem {
  id              String   @id @default(uuid())
  quoteId         String   @map("quote_id")
  description     String
  quantity        Decimal? @db.Decimal(12, 2)
  unit            String?
  unitPrice       Decimal? @map("unit_price") @db.Decimal(12, 2)
  totalPrice      Decimal? @map("total_price") @db.Decimal(12, 2)
  pricebookCode   String?  @map("pricebook_code")
  /// Catalog-shaped part name the agent emitted for pricing ("12 AWG THHN wire"). The
  /// description is customer-facing prose and often unmatchable; this is what every retry,
  /// sweep, and on-demand search should query with. Null on labor/diagnostic lines.
  searchTerm      String?  @map("search_term")
  /// Alternative-option grouping ("Option A", "Option B"). Null = base scope. Lines in
  /// different option groups are mutually exclusive alternatives: totals are computed per
  /// group and NEVER summed across groups — a customer picks one.
  optionGroup     String?  @map("option_group")
  /// Labor/diagnostic time rather than a purchasable material. The quote's markup percentage
  /// applies to materials ONLY, so this is the boundary that keeps labor out of it. Defaults
  /// to false: a line is a material unless something says otherwise. Set by the agent when it
  /// emits a labor line, and correctable by the technician on the Invoice tab.
  isLabor         Boolean  @default(false) @map("is_labor")
  agentSuggested  Boolean  @default(false) @map("agent_suggested")
  manuallyEdited  Boolean  @default(false) @map("manually_edited")
  /// Pending ambiguous reference: { action: "remove"|"update", candidateItemIds: string[], referenceText: string, fields?: object }
  ambiguousAction Json?    @map("ambiguous_action")
  /// Which of the company's named pricebooks priced this line (pricebook-config PRD US8).
  /// Null when the price came from Home Depot fallback, a manual edit, or nowhere yet.
  sourcePricebookId Int?   @map("source_pricebook_id")
  /// Labor line (labor PRD): quantity = hours, unit = "hr", unitPrice = hourly rate.
  /// Configured labor type this line was priced from. Null on a labor line = ad-hoc
  /// technician-stated rate (zero types configured / unmatched type / no valid rate).
  laborRateId     Int?     @map("labor_rate_id")
  /// QBO item this line bills against, picked in the per-line dropdown (QBO PRD US5).
  /// Null = auto: match the company's QBO item list by name at post time, create if missing.
  qboItemId       String?  @map("qbo_item_id")
  qboItemName     String?  @map("qbo_item_name")
  sortOrder       Int      @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  quote           Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_line_items")
  @@schema("public")
}

/// A named pricebook attached to a company (pricebook-config PRD US1). Priority is the
/// order books are CHECKED in and the tiebreaker for which book is shown as the price
/// source when two books carry the same item at the same price — the price that wins a
/// collision is always the HIGHER one, regardless of priority. Unique priority per company
/// is validated at configuration time (reorders swap values, so no DB constraint).
model Pricebook {
  id               Int      @id @default(autoincrement())
  companyId        Int      @map("company_id")
  name             String
  priority         Int
  /// csv | excel | pdf — the format the book was ingested from.
  sourceFormat     String?  @map("source_format")
  originalFilename String?  @map("original_filename")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([companyId, name])
  @@index([companyId])
  @@map("pricebooks")
  @@schema("public")
}

/// Per-client named hourly labor rates (labor PRD US1). Distinct schema from pricebooks
/// by explicit PRD decision: a labor type is a name + hourly rate, not a pricebook entry.
/// A rate of 0 is valid (comped/warranty work), distinct from "no rate configured".
model LaborRate {
  id         Int      @id @default(autoincrement())
  companyId  Int      @map("company_id")
  name       String
  hourlyRate Decimal  @map("hourly_rate") @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([companyId, name])
  @@index([companyId])
  @@map("labor_rates")
  @@schema("public")
}

/// Per-client quote template (template-config PRD US3). `renderer` keys into the code
/// registry in copilot/estimating/templates.ts — a custom client template is a new renderer
/// implemented in code, referenced by a row here. At most one active template per company
/// (validated at configuration time); no active row = the built-in default invoice.
model QuoteTemplate {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  name      String
  renderer  String   @default("invoice")
  config    Json     @default("{}")
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@map("quote_templates")
  @@schema("public")
}

model PricebookItem {
  id          Int      @id @default(autoincrement())
  companyId   Int      @map("company_id")
  code        String
  description String
  unit        String   @default("EA")
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  synonyms    String[] @default([])
  /// Which named pricebook this row belongs to. Null on HOME_DEPOT cache rows and on
  /// legacy seeded rows that predate named pricebooks.
  pricebookId Int?     @map("pricebook_id")

  /// Where this row came from. MANUAL rows are company-authored and never touched by the
  /// resolver; HOME_DEPOT rows are written by the catalog resolver on a pricebook miss so
  /// matchPricebook() finds them on the NEXT turn with no extra API call — the pricebook
  /// learns. Refresh and admin purge both key off this.
  source          PricebookSource @default(MANUAL)
  /// PROVISIONAL until a technician accepts the line it was created for. A bad resolve
  /// would otherwise become the company's permanent price for that item.
  provisional     Boolean         @default(false)
  /// Home Depot product identity (source = HOME_DEPOT only).
  externalId      String?         @map("external_id")
  externalLink    String?         @map("external_link")
  brand           String?
  rating          Decimal?        @db.Decimal(3, 2)
  /// Pack size behind unitPrice — guards a 12-pack price being stored as a unit price.
  packageQuantity Decimal?        @map("package_quantity") @db.Decimal(12, 2)
  /// Last time the external price was confirmed. Drives the refresh job.
  lastResolvedAt  DateTime?       @map("last_resolved_at")

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, source])
  @@index([externalId])
  @@index([pricebookId])
  @@map("pricebook_items")
  @@schema("public")
}

enum PricebookSource {
  MANUAL
  HOME_DEPOT

  @@map("pricebook_source")
  @@schema("public")
}

/// Problem-to-material associations taught by technicians (pre-seeded for MVP).
model KbEntry {
  id                  Int     @id @default(autoincrement())
  companyId           Int     @map("company_id")
  problem             String
  materialDescription String  @map("material_description")
  pricebookCode       String? @map("pricebook_code")
  defaultQuantity     Decimal @default(1) @map("default_quantity") @db.Decimal(12, 2)
  unit                String?

  @@index([companyId])
  @@map("kb_entries")
  @@schema("public")
}

