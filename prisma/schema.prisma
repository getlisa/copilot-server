generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public"]
}

model audio_files {
  id                       BigInt                 @id @default(autoincrement())
  visit_session_id         BigInt
  type                     String                 @db.VarChar(50)
  s3_uri                   String
  start_timestamp_ms       BigInt
  end_timestamp_ms         BigInt
  format                   String                 @db.VarChar(50)
  meta_data                Json?                  @default("{}")
  created_at               DateTime               @default(now()) @db.Timestamp(6)
  updated_at               DateTime               @default(now()) @db.Timestamp(6)
  transcription_session_id BigInt
  transcription_sessions   transcription_sessions @relation(fields: [transcription_session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  visit_sessions           visit_sessions         @relation(fields: [visit_session_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_audio_files_visit_session")

  @@index([visit_session_id], map: "idx_audio_files_visit_session_id")
  @@schema("public")
}

model companies {
  id                      Int                @id @default(autoincrement())
  name                    String             @db.VarChar
  logo_url                String?
  city                    String?            @db.VarChar
  state                   String?            @db.VarChar
  country                 String?            @db.VarChar
  postal_code             String?            @db.VarChar
  geocoded_lat            Float?
  geocoded_lng            Float?
  created_at              DateTime           @default(now()) @db.Timestamp(6)
  updated_at              DateTime           @default(now()) @db.Timestamp(6)
  address                 Json?              @default("{}")
  /// Service-location address from registration ({line1, city, state, postal_code, country}).
  /// `address` is the billing/mailing address; documents fall back to these when a job has none.
  service_address         Json?
  phone                   String?            @db.VarChar(20)
  email                   String?            @db.VarChar(200)
  license_number          String?            @db.VarChar(100)
  /// Per-company proposal email body with {{placeholders}}; null = built-in default.
  proposal_email_template String?
  /// Per-company proposal DOCUMENT format: an ordered ProposalBlock[] (see
  /// copilot/estimating/proposalTemplate.ts) driving both the emailed PDF and the .docx
  /// download. Null = the built-in hardcoded proposal, unchanged.
  proposal_template       Json?
  website                 String?            @db.VarChar(300)
  footer_terms            String?
  company_configs         company_configs?
  crm_connections         crm_connections?
  crm_entity_links        crm_entity_links[]
  jobs                    jobs[]
  users                   users[]

  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model company_configs {
  id                     Int       @id @default(autoincrement())
  company_id             Int       @unique
  checklists             Json
  updated_at             DateTime  @default(now()) @db.Timestamp(6)
  sales_coaching_enabled Boolean   @default(true)
  /// Home Depot fallback pricing for pricebook misses (pricebook-config PRD US5).
  /// Default ON (PM decision 2026-08-21): the automatic fallback is pre-existing behavior
  /// for every client, so this switch exists to opt a client OUT, not in. Turned off, that
  /// client's quotes price only from their own book(s).
  hd_fallback_enabled    Boolean   @default(true)
  /// Company default markup %, applied as the starting markupPercent of NEW quotes only
  /// (QBO PRD US7 — knowingly reverses the earlier per-quote-only markup decision).
  /// Per-quote markup stays editable; existing quotes are never touched by a change here.
  default_markup_percent Decimal   @default(0) @db.Decimal(5, 2)
  /// Whether sales tax applies to this company's estimates at all.
  ///
  /// Default OFF (product, 2026-09-09): most companies do not charge sales tax, and a rate that
  /// starts applying itself the moment someone configures one is a surprise measured in money.
  /// While QuickBooks OR a CRM is connected this is FORCED ON and cannot be turned off: the
  /// company invoices through a system that charges tax, so an estimate declaring none would
  /// disagree with what that system bills for the same job. Note that forcing tax on is NOT the
  /// same as making that system the tax SOURCE — taxSourceIsExternal stays QuickBooks-only, and a
  /// CRM company must charge tax AND type its own rates. See taxEnabledFor().
  ///
  /// Distinct from "no default rate set". Off means the company does not charge tax; no default
  /// means they do but have not said which rate — the first is a decision, the second is a gap.
  tax_enabled            Boolean   @default(false)
  companies              companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model jobs {
  id                    BigInt                 @id @default(autoincrement())
  company_id            Int
  technician_id         BigInt?
  start_timestamp       DateTime               @db.Timestamp(6)
  address               String                 @db.VarChar
  geocoded_lat          Float?
  geocoded_lng          Float?
  description           String?
  job_target_name       String                 @db.VarChar
  created_at            DateTime               @default(now()) @db.Timestamp(6)
  updated_at            DateTime               @default(now()) @db.Timestamp(6)
  status                job_status             @default(scheduled)
  meta_data             Json?
  conversations         Conversation[]
  companies             companies              @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                 users?                 @relation(fields: [technician_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  visit_session_metrics visit_session_metrics?
  visit_sessions        visit_sessions?

  @@schema("public")
}

model sessions {
  id                 Int      @id @default(autoincrement())
  user_id            BigInt
  refresh_token_hash String   @db.VarChar(255)
  user_agent         String?
  ip_address         String?  @db.Inet
  expires_at         DateTime @db.Timestamp(6)
  created_at         DateTime @default(now()) @db.Timestamp(6)
  updated_at         DateTime @default(now()) @db.Timestamp(6)
  users              users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model transcription_sessions {
  id                  BigInt                @id @default(autoincrement())
  visit_session_id    BigInt
  starts_at           DateTime?             @db.Timestamp(6)
  ends_at             DateTime?             @db.Timestamp(6)
  meta_data           Json?                 @default("{}")
  created_at          DateTime              @default(now()) @db.Timestamp(6)
  updated_at          DateTime              @default(now()) @db.Timestamp(6)
  last_heartbeat_at   DateTime?             @db.Timestamp(6)
  audio_files         audio_files[]
  visit_sessions      visit_sessions        @relation(fields: [visit_session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  transcription_turns transcription_turns[]

  @@index([visit_session_id], map: "idx_transcription_sessions_visit_session_id")
  @@schema("public")
}

model transcription_turns {
  id                       BigInt                 @id @default(autoincrement())
  visit_session_id         BigInt
  transcription_session_id BigInt
  turn_index               Int
  start_timestamp_ms       BigInt
  end_timestamp_ms         BigInt
  speaker                  String?                @db.VarChar(50)
  text                     String
  audio_s3_uri             String?
  meta_data                Json?                  @default("{}")
  created_at               DateTime               @default(now()) @db.Timestamp(6)
  updated_at               DateTime               @default(now()) @db.Timestamp(6)
  provider                 transcription_provider
  provider_result_id       String                 @db.VarChar(200)
  transcription_sessions   transcription_sessions @relation(fields: [transcription_session_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_transcription_turns_transcription_session")
  visit_sessions           visit_sessions         @relation(fields: [visit_session_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_transcription_turns_visit_session")

  @@index([transcription_session_id], map: "idx_transcription_turns_transcription_session_id")
  @@index([visit_session_id], map: "idx_transcription_turns_visit_session_id")
  @@schema("public")
}

model users {
  id                    BigInt                  @id @default(autoincrement())
  first_name            String                  @db.VarChar(100)
  last_name             String                  @db.VarChar(100)
  job_title             String?                 @db.VarChar(150)
  email                 String                  @unique(map: "idx_users_email") @db.VarChar(200)
  role                  user_role               @default(technician)
  hashed_password       String                  @db.VarChar(255)
  created_at            DateTime                @default(now()) @db.Timestamp(6)
  updated_at            DateTime                @default(now()) @db.Timestamp(6)
  company_id            Int
  address               Json?                   @default("{}")
  phone_number          String?                 @db.VarChar(20)
  username              String                  @db.VarChar(200)
  conversations         Conversation[]
  jobs                  jobs[]
  messages              Message[]
  sessions              sessions[]
  companies             companies               @relation(fields: [company_id], references: [id], onUpdate: NoAction, map: "fk_users_company")
  visit_session_metrics visit_session_metrics[]
  visit_sessions        visit_sessions[]

  @@unique([company_id, username], map: "uq_users_company_username")
  @@schema("public")
}

model visit_sessions {
  id                     BigInt                   @id @default(autoincrement())
  job_id                 BigInt                   @unique(map: "idx_visit_sessions_job_id")
  technician_id          BigInt
  start_time             DateTime                 @db.Timestamp(6)
  end_time               DateTime?                @db.Timestamp(6)
  status                 session_status           @default(active)
  meta_data              Json?                    @default("{}")
  created_at             DateTime                 @default(now()) @db.Timestamp(6)
  updated_at             DateTime                 @default(now()) @db.Timestamp(6)
  checklists             Json                     @default("{}")
  job_summary            String?
  audio_files            audio_files[]
  transcription_sessions transcription_sessions[]
  transcription_turns    transcription_turns[]
  jobs                   jobs                     @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_visit_sessions_job")
  users                  users                    @relation(fields: [technician_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_visit_sessions_technician")

  @@schema("public")
}

model Conversation {
  id             String             @id @default(uuid())
  userId         BigInt?            @map("user_id")
  jobId          BigInt?            @map("job_id")
  channelType    ChannelType        @map("channel_type")
  members        String[]
  status         ConversationStatus @default(ACTIVE)
  metadata       Json?              @default("{}")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  conversationId String?            @map("openai_conversation_id")
  jobs           jobs?              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  users          users?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageFiles     ImageFile[]
  messages       Message[]
  quote          Quote?

  @@index([userId])
  @@index([conversationId])
  @@index([status])
  @@index([createdAt])
  @@index([jobId], map: "conversations_job_id_key")
  @@map("conversations")
  @@schema("public")
}

model Message {
  id             String        @id @default(uuid())
  conversationId String        @map("conversation_id")
  senderType     SenderType    @map("sender_type")
  senderId       BigInt?       @map("sender_id")
  content        String
  contentType    ContentType   @default(TEXT) @map("content_type")
  attachments    Json?         @default("[]")
  metadata       Json?         @default("{}")
  status         MessageStatus @default(SENT)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  imageFiles     ImageFile[]
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  users          users?        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  toolCalls      ToolCall[]

  @@index([conversationId])
  @@index([senderType])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
  @@schema("public")
}

model ImageFile {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  /// Null for an image attached directly to the QUOTE (estimator attach action, PRD US6)
  /// rather than sent with a chat message. Message-attached images reach the agent as vision
  /// input; quote-attached images never do — no analysis of any kind, attach-and-display only.
  messageId      String?      @map("message_id")
  s3Key          String       @map("s3_key")
  mimeType       String       @map("mime_type")
  sizeBytes      BigInt?      @map("size_bytes")
  filename       String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        Message?     @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([messageId])
  @@map("image_files")
  @@schema("public")
}

model ToolCall {
  id          String         @id @default(uuid())
  messageId   String         @map("message_id")
  toolName    String         @map("tool_name")
  toolInput   Json           @map("tool_input")
  toolOutput  Json?          @map("tool_output")
  status      ToolCallStatus @default(PENDING)
  startedAt   DateTime       @default(now()) @map("started_at")
  completedAt DateTime?      @map("completed_at")
  durationMs  Int?           @map("duration_ms")
  error       String?
  message     Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([toolName])
  @@index([status])
  @@map("tool_calls")
  @@schema("public")
}

model visit_session_metrics {
  id                        BigInt   @id @default(autoincrement())
  job_id                    BigInt   @unique
  technician_id             BigInt
  technician_talk_time_sec  Int
  customer_talk_time_sec    Int
  technician_talk_ratio_pct Decimal  @db.Decimal(5, 2)
  total_exchanges           Int
  talk_speed_wpm            Int
  checklist_score_pct       Decimal  @db.Decimal(5, 2)
  star_rating               Decimal  @db.Decimal(2, 1)
  calculated_at             DateTime @default(now()) @db.Timestamp(6)
  meta_data                 Json     @default("{}")
  jobs                      jobs     @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_vsm_job")
  users                     users    @relation(fields: [technician_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_vsm_technician")

  @@schema("public")
}

model crm_connections {
  id               Int                @id @default(autoincrement())
  company_id       Int                @unique(map: "uq_crm_connections_company")
  provider         crm_provider
  auth_type        crm_auth_type
  encrypted_auth   Json
  provider_config  Json?
  expires_at       DateTime?          @db.Timestamptz(6)
  last_verified_at DateTime?          @db.Timestamptz(6)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  companies        companies          @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_crm_connections_company")
  crm_entity_links crm_entity_links[]

  @@schema("public")
}

model crm_entity_links {
  id                        BigInt          @id @default(autoincrement())
  company_id                Int
  crm_connection_id         Int
  entity_type               crm_entity_type
  canonical_id              BigInt
  provider_entity_id        String          @db.VarChar(128)
  provider_payload          Json?
  last_synced_at            DateTime?       @db.Timestamptz(6)
  remote_modified_at        DateTime?       @db.Timestamptz(6)
  created_at                DateTime        @default(now()) @db.Timestamptz(6)
  updated_at                DateTime        @default(now()) @db.Timestamptz(6)
  parent_provider_entity_id String?         @db.VarChar(128)
  provider_assignment_id    String?         @db.VarChar(128)
  companies                 companies       @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_crm_entity_links_company")
  crm_connections           crm_connections @relation(fields: [crm_connection_id], references: [id], onUpdate: NoAction, map: "fk_crm_entity_links_connection")

  @@unique([crm_connection_id, entity_type, canonical_id], map: "uq_canonical_entity")
  @@index([crm_connection_id, entity_type, remote_modified_at(sort: Desc)], map: "idx_crm_entity_links_connection_entity_remote_modified")
  @@schema("public")
}

/// ---------------------------------------------------------------------------------------------
/// The entity + `<entity>_qb` pattern (architecture, 2026-09-08).
///
/// CLARA owns the entity. A sibling `_qb` row holds what QuickBooks knows about it. The split
/// matters for three reasons: the entity has to work for a company with no accounting
/// integration at all; the QuickBooks id is only meaningful inside the realm that issued it; and
/// re-syncing Intuit's data must never be able to lose the record itself.
///
/// Which company is connected to which system already has two homes, and they are separate for a
/// reason, not by accident: `crm_connections` covers the field-service CRMs and is owned by the
/// platform backend — it is capped at one connection per company and its `crm_provider` enum
/// cannot take a new value without breaking that service's generated client. `qbo_connections`
/// is the QuickBooks counterpart. Same architecture, split by ownership.
///
/// Items already follow this pattern: `pricebook_items` is the entity, `qbo_item_links` is its
/// `_qb` side. It keeps its name because it also links lines that have no pricebook row at all
/// (labor and ad-hoc, 46% of production lines), which `pricebook_item_qb` would misdescribe.
/// ---------------------------------------------------------------------------------------------

/// A customer, as CLARA knows them. The source of truth for the estimate screen's picker and for
/// what a proposal prints — independent of whether the company uses QuickBooks.
model Customer {
  id        Int     @id @default(autoincrement())
  companyId Int     @map("company_id")
  name      String
  email     String?
  phone     String?
  /// The address exactly as it was typed or as QuickBooks holds it, joined. Kept alongside the
  /// structured columns below rather than replaced by them: the parse can be wrong, and the
  /// original is the only record of what the technician actually entered.
  address   String?

  /// BillAddr, structured (T-65). QuickBooks wants components, not a line of prose, and the
  /// jurisdiction that decides sales tax lives in `state` + `postalCode`. Populated from
  /// QuickBooks directly on ingest, or from `addressParse` on text a user typed — that parser
  /// only ever RESTRUCTURES what is present and never invents a missing ZIP or city, because a
  /// fabricated ZIP silently moves the tax jurisdiction.
  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String?
  /// CountrySubDivisionCode in QuickBooks' vocabulary — "AZ", not "Arizona".
  state        String?
  postalCode   String? @map("postal_code")
  country      String?

  /// Sub-customer parent (QuickBooks calls a child with `Job: true` a Job). Self-referential and
  /// nullable: most customers are roots. `SetNull` rather than `Cascade` — deleting a parent must
  /// orphan its children, never delete billable history along with them.
  ///
  /// No parent-qualified name scheme: QuickBooks' `DisplayName` is unique across customers,
  /// vendors and employees for the whole realm, so two children cannot share a name under
  /// different parents anyway, and `@@unique([companyId, name])` below already matches that rule.
  /// `CustomerQb.fullyQualifiedName` carries the readable "Parent:Child" chain.
  parentId Int?       @map("parent_id")
  parent   Customer?  @relation("CustomerHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Customer[] @relation("CustomerHierarchy")

  /// Audit + soft delete (architecture, 2026-09-08). `isDeleted` hides a row without losing the
  /// history that points at it; `isActive` is the reversible "not in use right now" state — the
  /// two are different questions and collapsing them loses one. createdBy/updatedBy are users.id
  /// with no FK, matching this schema's convention for service-managed tables, and nullable
  /// because ingestion and background work have no acting user to attribute.
  isActive  Boolean  @default(true) @map("is_active")
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  createdBy BigInt?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy BigInt?  @map("updated_by")

  quotes Quote[]
  qb     CustomerQb[]
  zt     CustomerZt[]

  /// Names are unique per company **and parent**, mirroring QuickBooks' actual DisplayName rule.
  ///
  /// It was `(companyId, name)` until a sandbox probe settled the question (2026-09-08): Intuit
  /// accepted `Mark Cho:Building 1` while `Mahee Zentrades:Building 1` already existed, so
  /// DisplayName is **sibling**-unique, not realm-unique. The narrower key was refusing customers
  /// QuickBooks would take — a technician adding "Building 1" to a second property was told it
  /// already existed, when it is a different building.
  ///
  /// The production index additionally carries `NULLS NOT DISTINCT` (Postgres 15+), which Prisma
  /// cannot express: without it every root customer has `parent_id IS NULL`, NULLs compare as
  /// distinct, and two top-level "Acme"s would both be allowed — losing the guarantee for the
  /// common case. See docs/sql/phase3.sql; the same documented divergence already exists for
  /// `sales_tax_one_default_per_company`.
  @@index([parentId])
  @@unique([companyId, parentId, name], map: "customers_company_id_parent_id_name_key")
  @@map("customers")
  @@schema("public")
}

/// What QuickBooks knows about one of our customers. One row per customer per realm: reconnect a
/// company to a different QuickBooks file and the old row stays, inert, rather than being
/// overwritten with an id that belongs to someone else's books.
model CustomerQb {
  id                 Int      @id @default(autoincrement())
  customerId         Int      @map("customer_id")
  companyId          Int      @map("company_id")
  /// The QuickBooks company (realm) that issued `qboId`.
  realmId            String   @map("realm_id")
  /// Customer.Id in QuickBooks.
  qboId              String   @map("qbo_id")
  /// DisplayName as QuickBooks holds it — may differ from our name if it was renamed there.
  displayName        String   @map("display_name")
  /// FullyQualifiedName: read-only in QuickBooks, and the parent chain joined by colons
  /// ("Customer:Job:Sub-job", up to 5 levels). This is what distinguishes two jobs that share a
  /// name under different parents — DisplayName alone cannot, and the picker showing only the
  /// leaf would make them indistinguishable.
  fullyQualifiedName String?  @map("fully_qualified_name")
  /// The untouched payload, so a later feature never needs a re-sync to read a field we did not
  /// think to promote.
  raw                Json?
  syncedAt           DateTime @default(now()) @map("synced_at")

  /// Audit + soft delete (architecture, 2026-09-08). `isDeleted` hides a row without losing the
  /// history that points at it; `isActive` is the reversible "not in use right now" state — the
  /// two are different questions and collapsing them loses one. createdBy/updatedBy are users.id
  /// with no FK, matching this schema's convention for service-managed tables, and nullable
  /// because ingestion and background work have no acting user to attribute.
  isActive  Boolean  @default(true) @map("is_active")
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  createdBy BigInt?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy BigInt?  @map("updated_by")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, realmId])
  @@unique([companyId, realmId, qboId], map: "customer_qb_company_id_realm_id_qbo_id_key")
  @@index([companyId, realmId])
  @@map("customer_qb")
  @@schema("public")
}

/// A sales tax rate the company can apply to estimates. CLARA's own record: a company with no
/// QuickBooks connection still needs a rate, and the estimate's arithmetic is ours either way.
///
/// Exactly one row per company may be the default, which is what a new estimate starts with.
/// Enforced by a partial unique index in the migration — Prisma cannot express one, so the
/// controller checks it too rather than relying on the database alone.
model SalesTax {
  id          Int     @id @default(autoincrement())
  companyId   Int     @map("company_id")
  /// What a technician sees, e.g. "California" or "Tucson".
  name        String
  /// "MANUAL" (typed in tax settings) or "QBO" (ingested).
  ///
  /// Drives the source-of-truth rule (product, 2026-09-08): a company connected to QuickBooks or
  /// a CRM takes its tax from that system, so it cannot create MANUAL rates and cannot use ones
  /// it created before connecting. Those rows are kept rather than deleted — disconnect and they
  /// become usable again, which a delete could not undo.
  source      String  @default("MANUAL")
  /// Percentage, e.g. 8.25. Four decimals because real rates include 9.0625%.
  ratePercent Decimal @map("rate_percent") @db.Decimal(6, 4)
  /// The rate new estimates start with (settings -> tax settings -> default sales tax).
  isDefault   Boolean @default(false) @map("is_default")

  /// Audit + soft delete (architecture, 2026-09-08). `isDeleted` hides a row without losing the
  /// history that points at it; `isActive` is the reversible "not in use right now" state — the
  /// two are different questions and collapsing them loses one. createdBy/updatedBy are users.id
  /// with no FK, matching this schema's convention for service-managed tables, and nullable
  /// because ingestion and background work have no acting user to attribute.
  isActive  Boolean  @default(true) @map("is_active")
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  createdBy BigInt?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy BigInt?  @map("updated_by")

  qb     SalesTaxQb[]
  zt     SalesTaxZt[]
  quotes Quote[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("sales_tax")
  @@schema("public")
}

/// What QuickBooks knows about one of our sales-tax rows. `qboType` distinguishes the two
/// entities Intuit models separately — a TaxRate carries the percentage, a TaxCode is what a
/// transaction line actually references — so a single rate may have one row of each.
model SalesTaxQb {
  id         Int      @id @default(autoincrement())
  salesTaxId Int      @map("sales_tax_id")
  companyId  Int      @map("company_id")
  realmId    String   @map("realm_id")
  /// "TaxRate" carries the percentage; "TaxCode" is what a transaction line references. Intuit
  /// models them separately, so one CLARA rate can hold a row of each.
  qboType    String   @map("qbo_type")
  qboId      String   @map("qbo_id")
  name       String
  raw        Json?
  syncedAt   DateTime @default(now()) @map("synced_at")

  /// Audit + soft delete (architecture, 2026-09-08). `isDeleted` hides a row without losing the
  /// history that points at it; `isActive` is the reversible "not in use right now" state — the
  /// two are different questions and collapsing them loses one. createdBy/updatedBy are users.id
  /// with no FK, matching this schema's convention for service-managed tables, and nullable
  /// because ingestion and background work have no acting user to attribute.
  isActive  Boolean  @default(true) @map("is_active")
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  createdBy BigInt?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy BigInt?  @map("updated_by")

  salesTax SalesTax @relation(fields: [salesTaxId], references: [id], onDelete: Cascade)

  // salesTaxId is part of the key: one QuickBooks rate belongs to MANY codes (a state rate sits
  // in every city group in that state), so a key without it lets the second code's insert
  // collide with the first's row — which aborts the whole sync, not just that member.
  @@unique([salesTaxId, companyId, realmId, qboType, qboId])
  @@index([salesTaxId])
  @@map("sales_tax_qb")
  @@schema("public")
}

/// ---------------------------------------------------------------------------------------------
/// Ingested QuickBooks reference data that has no CLARA-side entity of its own. Naming follows
/// the product convention raw_<entity>_qb. Customers and sales tax used to live here too; they
/// are now entities with `_qb` siblings, and their mirror tables are dropped in the same
/// migration — leaving the models behind would keep a client method pointing at a table that
/// does not exist. Each row keeps the entity's own QBO id plus the few fields we query on, and
/// the untouched payload in `raw` so a later feature never needs a re-sync to read a field we
/// did not think to promote.
///
/// These are a CACHE of someone else's system: never a source of truth, always scoped by
/// company_id, and every one of them must degrade to nothing when a company has no QuickBooks
/// connection — the tax and estimate features have to work standalone.
///
/// raw_item_qb doubles as the item REGISTRY. An item CLARA creates in QuickBooks is written here
/// with the id Intuit returned, so the next estimate that uses the same item reuses that id
/// instead of creating a duplicate. That is what makes "sync an item once, never again" hold
/// across estimates rather than only within one post.
/// ---------------------------------------------------------------------------------------------

/// CLARA item -> QuickBooks item id. Our mapping, deliberately separate from the raw_*_qb
/// mirror: those tables reflect Intuit's data, this one records a decision we made.
///
/// Implements "sync an item once, then reuse its id" (product, 2026-09-07). An estimate cannot
/// reference an item with no id, so items are ensured BEFORE the estimate payload is built and
/// the ids returned here are what the estimate carries. Reusing the same item on a later
/// estimate finds this row and creates nothing.
///
/// Identified two ways, because neither covers every line. Measured on production 2026-09-07:
/// of 674 quote lines, 366 carry a pricebook_code — and every one resolves to a pricebook_items
/// row, zero orphans — while 308 do not, including all 65 labor lines.
///   - pricebookItemId: the stable identity. Survives a rename in either system.
///   - itemKey: the casefolded item name, for labor and ad-hoc lines with no book row.
/// Postgres treats NULLs as distinct in a unique index, so the two keys coexist without
/// interfering: a pricebook-keyed row leaves itemKey null, and vice versa.
///
/// Scoped by realmId, not only companyId: an id means nothing outside the QuickBooks company
/// that issued it. Disconnect, reconnect to a DIFFERENT QuickBooks file, and every stored id
/// would otherwise point at a stranger's item.
model QboItemLink {
  id              Int      @id @default(autoincrement())
  companyId       Int      @map("company_id")
  /// The QBO company (realm) these ids belong to.
  realmId         String   @map("realm_id")
  /// pricebook_items.id when the line came from a price book. No FK, matching this schema's
  /// convention for runbook-managed DDL (see Pricebook / LaborRate).
  pricebookItemId Int?     @map("pricebook_item_id")
  /// Casefolded item name; used only when there is no pricebook row.
  itemKey         String?  @map("item_key")
  /// Item.Id in QuickBooks.
  qboItemId       String   @map("qbo_item_id")
  /// True when CLARA created the item rather than adopting one already in the customer's book.
  createdByClara  Boolean  @default(false) @map("created_by_clara")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([companyId, realmId, pricebookItemId])
  @@unique([companyId, realmId, itemKey])
  @@index([companyId, realmId])
  @@map("qbo_item_links")
  @@schema("public")
}

model RawQbItem {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  qboId     String   @map("qbo_id")
  name      String
  /// "Service" | "Inventory" | "NonInventory" — QBO's Item.Type.
  type      String?
  /// Whether QuickBooks treats this item as taxable, so lines billed against it inherit the
  /// right treatment instead of whatever QBO defaults to (QBO-INTEGRATION.md G14).
  taxable   Boolean?
  active    Boolean  @default(true)
  raw       Json
  syncedAt  DateTime @default(now()) @map("synced_at")

  @@unique([companyId, qboId])
  /// Lowercased on write, so a name lookup is case-insensitive without a functional index.
  @@unique([companyId, name])
  @@map("raw_item_qb")
  @@schema("public")
}

model RawQbAccount {
  id             Int      @id @default(autoincrement())
  companyId      Int      @map("company_id")
  qboId          String   @map("qbo_id")
  name           String
  /// AccountType, e.g. "Income". An admin picks the income account CLARA bills created items
  /// against, instead of the code taking whichever one QBO returns first (G10).
  accountType    String?  @map("account_type")
  accountSubType String?  @map("account_sub_type")
  active         Boolean  @default(true)
  raw            Json
  syncedAt       DateTime @default(now()) @map("synced_at")

  @@unique([companyId, qboId])
  @@index([companyId, accountType])
  @@map("raw_account_qb")
  @@schema("public")
}

/// QuickBooks Online connection, one per company. Deliberately NOT a crm_connections row:
/// that table is owned by the platform backend, is capped at one connection per company,
/// and extending its provider enum would break the other service's generated client on read.
/// No FK/relation, matching Pricebook/LaborRate (runbook-managed DDL).
///
/// Per-company OAuth TOKENS only. Clara owns the Intuit app, so the app keys live in server env
/// (QBO_CLIENT_ID / QBO_CLIENT_SECRET) and no row exists until a consent succeeds — the callback
/// creates it. Connected means encrypted_auth is non-null AND environment matches the server's.
/// The deferred per-company-app-keys design (client_id / encrypted_client_secret columns) is
/// documented at the top of src/lib/qbo.ts.
/// Raw ZenTrades ticket payloads — the read store for the Estimates-tab job picker and the
/// chat seeding. Estimates-tab-only scope: tickets are NEVER projected into `jobs`. The
/// complete untrimmed API object lives in rawPayload (raw-ingest rule): any field ZenTrades
/// returns stays queryable without a re-sync, and the write-back builds its estimate payload
/// (customer, addresses, tax zone) from here.
model ZtJobRaw {
  id           Int       @id @default(autoincrement())
  companyId    Int       @map("company_id")
  ztTicketId   String    @map("zt_ticket_id") @db.VarChar(64)
  ticketNumber String?   @map("ticket_number") @db.VarChar(64)
  /// ZenTrades' updatedAt — the sync cursor and the cheap change signal.
  ztUpdatedAt  DateTime? @map("zt_updated_at")
  rawPayload   Json      @map("raw_payload")
  /// sha256 of the payload (collections-agent pattern): full-list polling skips unchanged rows.
  contentHash  String    @map("content_hash") @db.VarChar(64)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([companyId, ztTicketId])
  @@index([companyId, ztUpdatedAt(sort: Desc)])
  @@map("zt_jobs_raw")
  @@schema("public")
}

/// Raw ZenTrades deficiencies. No canonical table (Estimates-tab-only scope): seeding and the
/// picker's open-count read these rows directly. `status` is projected out for cheap filtering.
model ZtDeficiencyRaw {
  id             Int      @id @default(autoincrement())
  companyId      Int      @map("company_id")
  ztDeficiencyId String   @map("zt_deficiency_id") @db.VarChar(64)
  ztTicketId     String?  @map("zt_ticket_id") @db.VarChar(64)
  status         String?  @db.VarChar(32)
  rawPayload     Json     @map("raw_payload")
  contentHash    String   @map("content_hash") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([companyId, ztDeficiencyId])
  @@index([companyId, ztTicketId])
  @@map("zt_deficiencies_raw")
  @@schema("public")
}

/// Raw ZenTrades price-catalog items — pricebook OR flat-rate rows (mutually exclusive per
/// company, so one table with `kind`). projectedItemId is the raw↔canonical mapping into
/// PricebookItem; the estimating agent prices from the projection with no agent changes.
model ZtCatalogRaw {
  id              Int      @id @default(autoincrement())
  companyId       Int      @map("company_id")
  kind            String   @db.VarChar(16)
  ztItemId        String   @map("zt_item_id") @db.VarChar(64)
  rawPayload      Json     @map("raw_payload")
  contentHash     String   @map("content_hash") @db.VarChar(64)
  projectedItemId Int?     @map("projected_item_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([companyId, kind, ztItemId])
  @@map("zt_catalog_raw")
  @@schema("public")
}

/// CLARA customer ↔ ZenTrades billing-customer id (the customer_qb pattern): a ZT-seeded quote
/// adopts by id first, so a re-sync or a second quote never duplicates the customer.
model CustomerZt {
  id           Int      @id @default(autoincrement())
  customerId   Int      @map("customer_id")
  companyId    Int      @map("company_id")
  ztCustomerId String   @map("zt_customer_id") @db.VarChar(64)
  raw          Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([companyId, ztCustomerId])
  @@index([customerId])
  @@map("customer_zt")
  @@schema("public")
}

/// sales_tax row ↔ ZenTrades rate id (the sales_tax_qb pattern), read at post time for the
/// estimate's salesTaxRateId reference.
model SalesTaxZt {
  id         Int      @id @default(autoincrement())
  salesTaxId Int      @map("sales_tax_id")
  companyId  Int      @map("company_id")
  ztRateId   String   @map("zt_rate_id") @db.VarChar(64)
  raw        Json?
  createdAt  DateTime @default(now()) @map("created_at")
  salesTax   SalesTax @relation(fields: [salesTaxId], references: [id], onDelete: Cascade)

  @@unique([companyId, ztRateId])
  @@index([salesTaxId])
  @@map("sales_tax_zt")
  @@schema("public")
}

/// One ZenTrades connection per company (ZenTrades plan 2.1/2.2) — the qbo_connections
/// pattern, split by provider on purpose (never extend the platform-owned crm_* family).
/// ZenTrades has no OAuth and no refresh token: auth is a normal user login whose session JWT
/// expires, so the sealed blob keeps {username, password, accessToken} and re-login with the
/// stored credentials is the only recovery path (same finding as the collections integration).
model ZtConnection {
  id                   Int       @id @default(autoincrement())
  companyId            Int       @unique @map("company_id")
  /// AES-256-GCM blob of { username, password, accessToken }, sealed under ZT_TOKEN_KEY (zt.ts).
  encryptedAuth        String?   @map("encrypted_auth")
  /// The ZenTrades company id, read from the login JWT payload. What every API call scopes to.
  ztCompanyId          String?   @map("zt_company_id")
  /// The ZenTrades company NAME from the login response (user.company.name) — shown on the
  /// Connections card so an admin sees WHICH account they bound, not just that one is bound.
  ztCompanyName        String?   @map("zt_company_name") @db.VarChar(200)
  ztUserId             String?   @map("zt_user_id")
  accessTokenExpiresAt DateTime? @map("access_token_expires_at")
  /// Sync bookkeeping (Phase 2 sync engine): last COMPLETE run, last failure, and the
  /// one-sync-at-a-time row claim — same semantics as QboConnection.
  lastSyncAt           DateTime? @map("last_sync_at")
  lastSyncError        String?   @map("last_sync_error")
  syncStartedAt        DateTime? @map("sync_started_at")
  /// Serializes re-login (QBO gap T-02, fixed here from day one): concurrent completions racing
  /// a session refresh would each replay a login; the conditional claim makes one win.
  refreshLockUntil     DateTime? @map("refresh_lock_until")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("zt_connections")
  @@schema("public")
}

model QboConnection {
  id                   Int       @id @default(autoincrement())
  companyId            Int       @unique @map("company_id")
  /// Which Intuit keyset minted these tokens: "production" | "sandbox". NOT an admin choice and
  /// NOT what selects the API base (the server env does that) — it is a stamp. Intuit issues
  /// separate Development and Production keysets, so tokens do not survive an environment flip;
  /// a mismatch here means "reconnect required" rather than an opaque 401 mid-quote.
  environment          String    @default("production")
  /// The QBO company id Intuit hands back on the OAuth callback. Null until consented.
  realmId              String?   @map("realm_id")
  /// AES-256-GCM blob of { accessToken, refreshToken }. Null until consented.
  encryptedAuth        String?   @map("encrypted_auth")
  accessTokenExpiresAt DateTime? @map("access_token_expires_at")

  /// The last reference sync that finished with every stage succeeding (T-45). Freshness used to
  /// be derived from the newest `customer_qb.synced_at`, which reports a run that ingested
  /// customers and then failed on items or tax as a clean success — the mirrors are stale and
  /// nothing says so. A run is a run: it either completed or it did not.
  lastSyncAt           DateTime? @map("last_sync_at")
  /// Which stages failed on the most recent attempt, cleared on the next success. Text rather
  /// than a code because it is shown to an admin who has to decide whether to retry.
  lastSyncError        String?   @map("last_sync_error")
  /// How this QuickBooks company calculates sales tax, read from `Preferences.TaxPrefs` (T-63).
  ///
  /// This decides whether CLARA's tax design applies at all. Under MANUAL tax an explicit
  /// `TxnTaxDetail.TxnTaxCodeRef` is honoured, which is what the snapshot model depends on.
  /// Under Automated Sales Tax (`PartnerTaxEnabled`) Intuit IGNORES the code and computes from
  /// the address instead, so a posted estimate would quietly disagree with the signed document.
  /// Null means it has not been read yet — treated as "not known to be automated".
  usingSalesTax        Boolean?  @map("using_sales_tax")
  partnerTaxEnabled    Boolean?  @map("partner_tax_enabled")
  /// When the currently-running sync claimed this company, or null when none is running (T-44).
  ///
  /// A row claim rather than a Postgres advisory lock. Session advisory locks are RE-ENTRANT:
  /// two concurrent syncs sharing one pooled connection both take the lock, both proceed, and
  /// the first unlock releases it for both — the guard reads as working and prevents nothing.
  /// A conditional UPDATE gated on the row count has none of that ambiguity, and it survives a
  /// crashed task through the staleness window rather than wedging the company forever.
  syncStartedAt        DateTime? @map("sync_started_at")

  /// Indexed because the webhook drain resolves realm -> companies on every pass. Deliberately
  /// NOT unique: one realm may legitimately serve several companies, and the fan-out is the
  /// design (see qboWebhookProcessor.companiesForRealm).
  @@index([realmId], map: "qbo_connections_realm_id_idx")

  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("qbo_connections")
  @@schema("public")
}

/// One inbound QuickBooks webhook CloudEvent. Both a dedup ledger and a queryable status trail.
///
/// WHY A TABLE AND NOT A QUEUE. collection_agent_backend puts these on SQS with a dedicated worker
/// container. That is the right shape there and the wrong one here: this service has no queue, no
/// worker, no cron and one ECS task, so SQS would mean a new queue, a new container, new IAM and
/// a new deploy path to move work a table already tracks. The drain is an in-process loop that
/// claims rows with a conditional updateMany gated on the row count — the same pattern
/// `qbo_connections.sync_started_at` uses, and chosen for the same reason: a `pg_advisory_lock`
/// is RE-ENTRANT, so two runs sharing a pooled connection both "acquire" it and the first unlock
/// frees it for both. The claim stays correct if the service ever scales past one task.
///
/// `eventId` UNIQUE is the whole dedup guarantee. Intuit redelivers on any non-2xx and repeats
/// the CloudEvents `id` verbatim, so the insert is what makes a redelivery a no-op.
model QboWebhookEvent {
  id BigInt @id @default(autoincrement())
  /// CloudEvents `id`. THE dedup key — a redelivery repeats it.
  eventId String @unique @map("event_id")
  /// `intuitaccountid`. Resolved to companies at drain time, not here: one realm can legitimately
  /// be connected to more than one company, and the receiver must stay fast.
  realmId String @map("realm_id")
  /// Which keyset's verifier token matched — "sandbox" | "production". Nothing in the CloudEvent
  /// itself says, and one endpoint serves both keysets.
  keyset String?
  /// Lowercased entity segment of `type`, or null when it is not one we subscribed to.
  entity String?
  /// Operation segment of `type`, kept verbatim. Never validated against an enum: the vocabulary
  /// is not fully documented, and an unknown operation is treated as "refetch", which is safe.
  operation String
  /// `intuitentityid` — the entity's QuickBooks Id.
  entityId String? @map("entity_id")
  eventTime DateTime? @map("event_time") @db.Timestamptz(6)
  /// The untouched CloudEvent, so debugging, replay and audit survive a lossy projection.
  raw Json
  /// queued | running | done | skipped | failed
  status String @default("queued")
  attempts Int @default(0)
  lastError String? @map("last_error")
  /// Set with `claimToken` when a drain pass takes the row, cleared when it settles. A row stuck
  /// in `running` past the staleness window returns to `queued` — a killed task must not wedge an
  /// event forever.
  /// When this row may next be attempted. Set to a backed-off future time on every requeue, so a
  /// stuck tenant cannot occupy every pass (head-of-line starvation) and five attempts span hours
  /// rather than the ~50 seconds a fixed 10s interval gives -- long enough to outlast a QuickBooks
  /// throttle window. Null means "eligible now".
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(6)
  /// Companies that have already completed this event, for the realm fan-out. One realm can serve
  /// several companies; without this, a permanently broken sibling requeues the row forever and
  /// re-runs the healthy company's full mirror pull on every pass.
  doneCompanies Int[] @default([]) @map("done_companies")
  claimedAt DateTime? @map("claimed_at") @db.Timestamptz(6)
  /// Identifies the drain pass that owns the row. A count alone cannot say WHICH rows a batch
  /// claim won when two passes overlap on part of the same id list.
  claimToken String? @map("claim_token")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt, createdAt], map: "qbo_webhook_events_drain_idx")
  @@index([realmId, createdAt(sort: Desc)], map: "qbo_webhook_events_realm_idx")
  @@map("qbo_webhook_events")
  @@schema("public")
}


/// Estimating Agent: one chat = one quote, lifecycle DRAFT -> COMPLETED.
/// Audit columns (architecture, 2026-09-08): `quotes` and `quote_line_items` are DELIBERATELY
/// exempt from the created_by/updated_by rule that the customer and sales-tax tables follow.
/// A quote already carries `user_id` — its author, with a FK's worth of meaning — and quotes are
/// hard-deleted with their conversation rather than soft-deleted, so `is_deleted`/`is_active`
/// would be columns nothing ever sets. The rule exists for service-managed reference data that
/// outlives the person who entered it; a quote is neither.
model Quote {
  id                String          @id @default(uuid())
  conversationId    String          @unique @map("conversation_id")
  userId            BigInt          @map("user_id")
  companyId         Int             @map("company_id")
  status            QuoteStatus     @default(DRAFT)
  /// Per-quote materials markup, as a percentage. Applies to MATERIAL lines only — labor is
  /// never marked up (isLabor). 0 = no markup. Editable while DRAFT, frozen on COMPLETED.
  /// Deliberately per-quote: there is no client-level default markup anywhere in the product.
  markupPercent     Decimal         @default(0) @map("markup_percent") @db.Decimal(5, 2)
  /// Customer identification, per quote. Free text with NO format validation (PRD is
  /// explicit), all optional — a quote completes with zero, one, two, or all three set.
  /// Per-quote data like line items: never persisted, deduped, or autofilled across quotes.
  customerName      String?         @map("customer_name")
  customerAddress   String?         @map("customer_address")
  customerPhone     String?         @map("customer_phone")
  /// Template in effect when this quote was CREATED (template-config PRD): a later template
  /// reassignment never touches an existing quote. Null = the built-in default invoice.
  templateId        Int?            @map("template_id")
  /// The end-of-materials labor-hours ask fires at most once per quote (labor PRD US2).
  laborAsked        Boolean         @default(false) @map("labor_asked")
  /// The customer-facing proposal template chosen in chat (template-library). Null = the
  /// company's default template resolves at render time. Plain column, no FK — a deleted
  /// template must fall through the render chain (chosen → default → built-in), never block.
  proposalTemplateId Int?           @map("proposal_template_id")
  /// The which-proposal-template ask fires at most once per quote (mirrors laborAsked).
  templateAsked     Boolean         @default(false) @map("template_asked")
  /// ZenTrades linkage (Estimates-tab flow): the originating ticket this quote was started
  /// from, and the estimate it posted as. ztBillingMetaDataId comes back on the create and is
  /// what ZenTrades' estimate UPDATE requires — persisted so reopen→re-complete can update in
  /// place. Same outcome-recording rationale as the qbo_* trio.
  ztTicketId          String?       @map("zt_ticket_id") @db.VarChar(64)
  ztEstimateId        String?       @map("zt_estimate_id") @db.VarChar(64)
  ztBillingMetaDataId String?       @map("zt_billing_meta_data_id") @db.VarChar(64)
  ztSyncedAt          DateTime?     @map("zt_synced_at")
  ztSyncError         String?       @map("zt_sync_error")
  /// QBO Estimate id once posted (companies with a QboConnection). Posted at completion;
  /// re-completing after a reopen UPDATES this same estimate in place (QBO PRD US6).
  qboEstimateId     String?         @map("qbo_estimate_id")
  /// When the estimate last reached QuickBooks, and why it last did not (T-17).
  ///
  /// The post is fire-and-forget, so a failure used to be a log line and nothing else: the
  /// technician saw a completed quote, the estimate was never in the books, and the retry
  /// endpoint existed with nothing to tell anyone to call it. Recorded here so the screen can
  /// say so and offer the retry. Cleared on the next success.
  qboSyncedAt       DateTime?       @map("qbo_synced_at")
  qboSyncError      String?         @map("qbo_sync_error")
  /// QuickBooks' `SyncToken` for `qboEstimateId` as of OUR last write to it.
  ///
  /// QBO bumps the token on every change to the estimate, whoever made it. Storing what the
  /// token was when we last wrote is what lets a webhook tell the two apart: a token that has
  /// moved past this one means somebody edited the estimate inside QuickBooks. Without it every
  /// `estimate.update` is indistinguishable from the echo of our own post.
  ///
  /// Null on quotes that posted before this column existed. That reads as "unknown", not "not
  /// drifted" — the first webhook after a re-completion establishes the baseline.
  qboSyncToken      String?         @map("qbo_sync_token")
  /// When a webhook first showed the estimate had moved past `qboSyncToken`.
  ///
  /// Set by the drain, cleared by our own next successful write (that write is authoritative
  /// again, and re-completion deliberately overwrites). It exists so re-completion can WARN
  /// instead of silently discarding an edit the client made in their own books — the update-in-
  /// place path (US6) overwrites unconditionally today.
  qboRemoteChangedAt DateTime?      @map("qbo_remote_changed_at")
  /// The customer this estimate bills to, chosen or created on the estimate screen. Null on
  /// quotes that predate the picker — those still print the free-text customerName below, and
  /// the QuickBooks post falls back to matching on that name.
  ///
  /// The QuickBooks id is NOT duplicated here: it lives on customer_qb, keyed by realm, so a
  /// reconnect to a different QuickBooks file cannot leave a stale id attached to an estimate.
  customerId        Int?            @map("customer_id")
  customer          Customer?       @relation(fields: [customerId], references: [id])
  /// The sales-tax rate this estimate was created under — a SNAPSHOT, not a live lookup. The
  /// tax settings card promises "existing estimates keep the rate they were created with", so
  /// the rate is resolved once, at creation, and never re-resolved. `SetNull` keeps the estimate
  /// and its `taxRatePercent` intact if the rate row is later removed.
  ///
  /// Null is meaningful and distinct from a 0% rate: null means no tax was ever configured, and
  /// the QuickBooks post omits `TxnTaxDetail` entirely rather than declaring zero tax (F20).
  /// Every quote that predates this column is null, by decision — there is no backfill.
  ///
  /// `Restrict`, not `SetNull`, and the two are not interchangeable here. Rates are only ever
  /// SOFT-deleted, so this never fires in normal operation — but if a rate were ever hard-deleted,
  /// `SetNull` would clear `sales_tax_id` while leaving `tax_rate_percent` set, breaking the
  /// pairing the CHECK constraint enforces and leaving an estimate quoting a percentage that
  /// belongs to nothing. Failing the delete is the honest outcome.
  salesTaxId        Int?            @map("sales_tax_id")
  salesTax          SalesTax?       @relation(fields: [salesTaxId], references: [id], onDelete: Restrict)
  /// The percentage as it stood at creation, copied so a later edit to the rate cannot silently
  /// re-price an estimate that has already been sent.
  taxRatePercent    Decimal?        @map("tax_rate_percent") @db.Decimal(6, 4)
  /// This job is deliberately untaxed — someone cleared the rate rather than never having one.
  ///
  /// Without this the two states are the same row: `sales_tax_id IS NULL`. Completion fills a
  /// missing snapshot from the company default (so a quote started before tax existed is not
  /// completed untaxed by accident), and that gap-fill would otherwise undo an explicit clear
  /// on the way out — making "not taxable" impossible to express at all.
  taxExempt         Boolean         @default(false) @map("tax_exempt")
  /// Which option group the customer chose, answered at completion time (QBO PRD US3).
  /// Null = not asked / no options. Cleared on reopen so re-completion asks again.
  chosenOptionGroup String?         @map("chosen_option_group")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  completedAt       DateTime?       @map("completed_at")
  conversation      Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  lineItems         QuoteLineItem[]

  @@index([userId, status])
  @@index([salesTaxId])
  /// The webhook drain resolves an estimate event to its quote by (company, QBO estimate id) on
  /// every compare-able event, and the MISS is the common case — most estimates in a client's
  /// books were never posted by CLARA. Without this that miss is a full scan of `quotes`.
  @@index([companyId, qboEstimateId], map: "quotes_company_id_qbo_estimate_id_idx")
  @@map("quotes")
  @@schema("public")
}

model QuoteLineItem {
  id                String   @id @default(uuid())
  quoteId           String   @map("quote_id")
  description       String
  quantity          Decimal? @db.Decimal(12, 2)
  unit              String?
  unitPrice         Decimal? @map("unit_price") @db.Decimal(12, 2)
  totalPrice        Decimal? @map("total_price") @db.Decimal(12, 2)
  pricebookCode     String?  @map("pricebook_code")
  /// Catalog-shaped part name the agent emitted for pricing ("12 AWG THHN wire"). The
  /// description is customer-facing prose and often unmatchable; this is what every retry,
  /// sweep, and on-demand search should query with. Null on labor/diagnostic lines.
  searchTerm        String?  @map("search_term")
  /// Alternative-option grouping ("Option A", "Option B"). Null = base scope. Lines in
  /// different option groups are mutually exclusive alternatives: totals are computed per
  /// group and NEVER summed across groups — a customer picks one.
  optionGroup       String?  @map("option_group")
  /// Labor/diagnostic time rather than a purchasable material. The quote's markup percentage
  /// applies to materials ONLY, so this is the boundary that keeps labor out of it. Defaults
  /// to false: a line is a material unless something says otherwise. Set by the agent when it
  /// emits a labor line, and correctable by the technician on the Invoice tab.
  isLabor           Boolean  @default(false) @map("is_labor")
  agentSuggested    Boolean  @default(false) @map("agent_suggested")
  manuallyEdited    Boolean  @default(false) @map("manually_edited")
  /// Pending ambiguous reference: { action: "remove"|"update", candidateItemIds: string[], referenceText: string, fields?: object }
  ambiguousAction   Json?    @map("ambiguous_action")
  /// Which of the company's named pricebooks priced this line (pricebook-config PRD US8).
  /// Null when the price came from Home Depot fallback, a manual edit, or nowhere yet.
  sourcePricebookId Int?     @map("source_pricebook_id")
  /// Labor line (labor PRD): quantity = hours, unit = "hr", unitPrice = hourly rate.
  /// Configured labor type this line was priced from. Null on a labor line = ad-hoc
  /// technician-stated rate (zero types configured / unmatched type / no valid rate).
  laborRateId       Int?     @map("labor_rate_id")
  /// QBO item this line bills against, picked in the per-line dropdown (QBO PRD US5).
  /// Null = auto: match the company's QBO item list by name at post time, create if missing.
  qboItemId         String?  @map("qbo_item_id")
  qboItemName       String?  @map("qbo_item_name")
  /// Whether sales tax applies to this line. Defaults true, matching both QuickBooks' own default
  /// and the common case; the per-line toggle exists for the exceptions (a permit fee, a
  /// non-taxable service). Maps to `TaxCodeRef` = `TAX` or `NON` on the posted estimate.
  taxable           Boolean  @default(true)
  sortOrder         Int      @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  quote             Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_line_items")
  @@schema("public")
}

/// A named pricebook attached to a company (pricebook-config PRD US1). Priority is the
/// order books are CHECKED in and the tiebreaker for which book is shown as the price
/// source when two books carry the same item at the same price — the price that wins a
/// collision is always the HIGHER one, regardless of priority. Unique priority per company
/// is validated at configuration time (reorders swap values, so no DB constraint).
model Pricebook {
  id               Int      @id @default(autoincrement())
  companyId        Int      @map("company_id")
  name             String
  priority         Int
  /// csv | excel | pdf — the format the book was ingested from.
  sourceFormat     String?  @map("source_format")
  originalFilename String?  @map("original_filename")
  /// "MANUAL" (admin-uploaded) or "ZENTRADES" (synced catalog). Pricing priority rule: an
  /// admin-uploaded book always outranks the synced catalog — fallback, never a merge.
  source           String   @default("MANUAL") @db.VarChar(16)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([companyId, name])
  @@index([companyId])
  @@map("pricebooks")
  @@schema("public")
}

/// Per-client named hourly labor rates (labor PRD US1). Distinct schema from pricebooks
/// by explicit PRD decision: a labor type is a name + hourly rate, not a pricebook entry.
/// A rate of 0 is valid (comped/warranty work), distinct from "no rate configured".
model LaborRate {
  id         Int      @id @default(autoincrement())
  companyId  Int      @map("company_id")
  name       String
  hourlyRate Decimal  @map("hourly_rate") @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([companyId, name])
  @@index([companyId])
  @@map("labor_rates")
  @@schema("public")
}

/// Per-client quote template (template-config PRD US3). `renderer` keys into the code
/// registry in copilot/estimating/templates.ts — a custom client template is a new renderer
/// implemented in code, referenced by a row here. At most one active template per company
/// (validated at configuration time); no active row = the built-in default invoice.
/// A named customer-facing proposal design (template-library). Replaces the single
/// companies.proposal_template column: each company keeps a library of these, exactly one
/// marked default. `blocks` is the same ordered ProposalBlock[] the column held (see
/// copilot/estimating/proposalTemplate.ts) — format and renderers unchanged.
///
/// One default per company is enforced by the partial unique index
/// proposal_templates_one_default_per_company (docs/sql/phase4.sql) — Prisma cannot express
/// a partial unique index, so the schema declares only the columns.
model ProposalTemplate {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  name      String   @db.VarChar(120)
  blocks    Json
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("proposal_templates")
  @@schema("public")
}

model QuoteTemplate {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  name      String
  renderer  String   @default("invoice")
  config    Json     @default("{}")
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@map("quote_templates")
  @@schema("public")
}

model PricebookItem {
  id          Int      @id @default(autoincrement())
  companyId   Int      @map("company_id")
  code        String
  description String
  unit        String   @default("EA")
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  synonyms    String[] @default([])
  /// Which named pricebook this row belongs to. Null on HOME_DEPOT cache rows and on
  /// legacy seeded rows that predate named pricebooks.
  pricebookId Int?     @map("pricebook_id")

  /// Where this row came from. MANUAL rows are company-authored and never touched by the
  /// resolver; HOME_DEPOT rows are written by the catalog resolver on a pricebook miss so
  /// matchPricebook() finds them on the NEXT turn with no extra API call — the pricebook
  /// learns. Refresh and admin purge both key off this.
  source          PricebookSource @default(MANUAL)
  /// PROVISIONAL until a technician accepts the line it was created for. A bad resolve
  /// would otherwise become the company's permanent price for that item.
  provisional     Boolean         @default(false)
  /// Home Depot product identity (source = HOME_DEPOT only).
  externalId      String?         @map("external_id")
  externalLink    String?         @map("external_link")
  brand           String?
  rating          Decimal?        @db.Decimal(3, 2)
  /// Pack size behind unitPrice — guards a 12-pack price being stored as a unit price.
  packageQuantity Decimal?        @map("package_quantity") @db.Decimal(12, 2)
  /// Last time the external price was confirmed. Drives the refresh job.
  lastResolvedAt  DateTime?       @map("last_resolved_at")

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, source])
  @@index([externalId])
  @@index([pricebookId])
  @@map("pricebook_items")
  @@schema("public")
}

enum PricebookSource {
  MANUAL
  HOME_DEPOT
  ZENTRADES

  @@map("pricebook_source")
  @@schema("public")
}

/// Problem-to-material associations taught by technicians (pre-seeded for MVP).
model KbEntry {
  id                  Int     @id @default(autoincrement())
  companyId           Int     @map("company_id")
  problem             String
  materialDescription String  @map("material_description")
  pricebookCode       String? @map("pricebook_code")
  defaultQuantity     Decimal @default(1) @map("default_quantity") @db.Decimal(12, 2)
  unit                String?

  @@index([companyId])
  @@map("kb_entries")
  @@schema("public")
}

