{
    "compilerOptions": {
      "target": "ES2022",
      "module": "commonjs",
      "rootDir": "./src",
      "outDir": "./dist",
      "skipLibCheck": true,
      "strict": true,
      "noUncheckedIndexedAccess": false,
      "esModuleInterop": true,
      "strictNullChecks": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "scripts"]
  }