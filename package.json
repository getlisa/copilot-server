{
  "name": "technician-copilot",
  "version": "1.0.0",
  "description": "Technician Copilot - AI-powered assistant for technicians",
  "main": "server.js",
  "scripts": {
    "start": "tsc && node dist/server.js",
    "dev": "AWS_PROFILE=copilot-dev nodemon --watch src --ext ts,json --exec 'tsc && tsx src/server.ts'",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "check:pricebook": "tsx scripts/check-pricebook-amperage.ts",
    "check:electrical": "tsx scripts/check-electrical-cases.ts",
    "check:catalog": "tsx scripts/check-home-depot-catalog.ts",
    "test": "npm run typecheck && npm run check:pricebook && npm run check:pack && npm run check:estimatelink && npm run check:markup && npm run check:customerdetails && npm run check:proposalphotos && npm run check:proposalemail && npm run check:collision && npm run check:ingest && npm run check:flags && npm run check:template && npm run check:proposaltemplate && npm run check:proposalimport",
    "check:proposalphotos": "tsx scripts/check-proposal-photos.ts",
    "check:proposalemail": "tsx scripts/check-proposal-email.ts",
    "check:template": "tsx scripts/check-template.ts",
    "check:proposaltemplate": "tsx scripts/check-proposal-template.ts",
    "check:proposalimport": "tsx scripts/check-proposal-import.ts",
    "check:collision": "tsx scripts/check-collision.ts",
    "check:ingest": "tsx scripts/check-ingest.ts",
    "check:flags": "tsx scripts/check-flags.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "check:pack": "tsx scripts/check-pack-parsing.ts",
    "check:options": "tsx scripts/check-option-totals.ts",
    "check:estimatelink": "tsx scripts/check-estimate-link.ts",
    "check:markup": "tsx scripts/check-markup.ts",
    "check:customerdetails": "tsx scripts/check-customer-details.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.694.0",
    "@aws-sdk/s3-request-presigner": "^3.694.0",
    "@dqbd/tiktoken": "^1.0.14",
    "@langchain/core": "^1.1.49",
    "@langchain/langgraph": "^1.4.2",
    "@prisma/client": "^6.19.0",
    "@sendgrid/mail": "^8.1.6",
    "@types/cors": "^2.8.19",
    "@types/multer": "^2.0.0",
    "@types/pdfkit": "^0.17.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "docx": "^9.7.1",
    "docxtemplater": "^3.69.3",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "geo-tz": "^8.1.6",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "openai": "^6.9.1",
    "pdfjs-dist": "^3.11.174",
    "pdfkit": "^0.19.1",
    "pizzip": "^3.2.0",
    "sharp": "^0.35.3",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.10",
    "nodemon": "^3.1.11",
    "prisma": "^6.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
